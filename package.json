{
  "name": "shaykit",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:prebuild": "expo prebuild --platform android",
    "android:bundle:release": "npm run android:prebuild && (cd android && ./gradlew app:bundleRelease)",
    "ios": "expo run:ios",
    "publish:play": "node ./scripts/publish-play.mjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~55.0.6",
    "expo-dev-client": "~55.0.16",
    "expo-haptics": "~55.0.8",
    "expo-sensors": "^55.0.8",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.2"
  },
  "devDependencies": {
    "googleapis": "^166.0.0"
  },
  "private": true
}
